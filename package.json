{
  "name": "tsmc",
  "version": "0.0.0",
  "private": true,
  "description": "Telegram Serverless Media Center — media center chạy hoàn toàn trong trình duyệt",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.23.0",
  "scripts": {
    "spike": "npx --yes serve spike --listen 5173",
    "deploy:spike": "npx --yes firebase-tools hosting:channel:deploy spike-01 --expires 7d",
    "deploy:staging": "npx --yes firebase-tools deploy --only hosting",
    "spike:auto": "node tools/spike-runner/run.mjs",
    "docs:check": "node tools/docs-check/check.mjs",
    "lint": "eslint .",
    "test:libs": "vitest run --root libs",
    "build:web": "pnpm --filter web run build",
    "build:sw": "node sw/build.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "puppeteer-core": "^23.11.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
