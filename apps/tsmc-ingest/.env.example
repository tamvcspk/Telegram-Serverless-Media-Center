# Copy file này thành .env (cùng thư mục bạn chạy `tsmc-ingest` từ đó, thường
# là gốc repo) rồi điền giá trị thật. .env đã bị .gitignore chặn ở gốc repo —
# KHÔNG commit .env thật.
#
# Tự tạo API_ID/API_HASH tại https://my.telegram.org — đây là credential do
# CHÍNH BẠN cấp cho tài khoản của bạn, không phải bí mật server nào cả
# (CLAUDE.md bất biến #1).
TSMC_API_ID=
TSMC_API_HASH=

# Tuỳ chọn — chỉ dùng cho lệnh `login`. Có thì bỏ qua prompt nhập số điện
# thoại; không có thì CLI hỏi tay như bình thường. Định dạng quốc tế, vd +84912345678.
TSMC_PHONE_NUMBER=
